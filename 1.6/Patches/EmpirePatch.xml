<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef[defName = "RK_Veteran_Residence_General"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationSequence">
    <operations>
	
    <li Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/FactionDef[defName = "Empire"]/permanentEnemyToEveryoneExcept</xpath>
      <value>
        <li>RK_Veteran_Residence_General</li>
      </value>
    </li>
	
    </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef[defName = "RK_Veteran_Residence_Elite"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationSequence">
    <operations>
	
    <li Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/FactionDef[defName = "Empire"]/permanentEnemyToEveryoneExcept</xpath>
      <value>
        <li>RK_Veteran_Residence_Elite</li>
      </value>
    </li>
	
    </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef[defName = "RatkinRepublic"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationSequence">
    <operations>
	
    <li Class="PatchOperationAdd">
      <success>Always</success>
      <xpath>/Defs/FactionDef[defName = "Empire"]/permanentEnemyToEveryoneExcept</xpath>
      <value>
        <li>RK_Veteran_Residence_General</li>
        <li>RK_Veteran_Residence_Elite</li>
      </value>
    </li>
	
    </operations>
    </match>
  </Operation>
  
</Patch>